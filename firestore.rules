rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection - allow authenticated users to read/write their own data
    match /users/{userId} {
      // Allow read if user is authenticated and owns the document
      allow read: if isOwner(userId);
      
      // Allow create if user is authenticated and creating their own document
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // Allow update if user is authenticated and owns the document
      allow update: if isOwner(userId);
      
      // Allow delete if user is authenticated and owns the document
      allow delete: if isOwner(userId);
      
      // User subcollections: preferences and tokens
      match /preferences/{preferenceId} {
        allow read, write: if isOwner(userId);
      }
      
      match /tokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Wardrobe collection - users can only access their own items
    match /wardrobe/{itemId} {
      // Allow read if user owns the item
      allow read: if isAuthenticated() && 
        (resource == null || resource.data.userId == request.auth.uid);
      
      // Allow create if user is authenticated and creating their own item
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      
      // Allow update if user owns the item
      allow update: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      // Allow delete if user owns the item
      allow delete: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
    }
    
    // Outfits collection - users can only access their own outfits
    match /outfits/{outfitId} {
      // Allow read if user owns the outfit
      allow read: if isAuthenticated() && 
        (resource == null || resource.data.userId == request.auth.uid);
      
      // Allow create if user is authenticated and creating their own outfit
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      
      // Allow update if user owns the outfit
      allow update: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      // Allow delete if user owns the outfit
      allow delete: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
    }
    
    // Avatars collection - users can only access their own avatar
    match /avatars/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}

