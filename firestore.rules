// Firestore Security Rules
// Deploy after changes: firebase deploy --only firestore:rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection - allow authenticated users to read/write their own data
    // Read: any authenticated user can read (for profile name/avatar in social)
    match /users/{userId} {
      allow read: if isAuthenticated();
      
      // Allow create: owner; or another user only setting 'friends' with themselves (accept friend request when doc missing)
      allow create: if isAuthenticated() && (
        request.auth.uid == userId
        || (request.auth.uid != userId
            && request.resource.data.keys().hasOnly(['friends'])
            && request.resource.data.friends.hasAny([request.auth.uid]))
      );
      
      // Allow update: owner always; or add-self-to-friends only (accept friend request)
      allow update: if isAuthenticated() && (
        request.auth.uid == userId
        || (request.auth.uid != userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends'])
            && request.resource.data.friends.hasAny([request.auth.uid]))
      );
      
      // Allow delete if user is authenticated and owns the document
      allow delete: if isOwner(userId);
      
      // User subcollections: preferences and tokens
      match /preferences/{preferenceId} {
        allow read, write: if isOwner(userId);
      }
      
      match /tokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Wardrobe collection - users can only access their own items
    match /wardrobe/{itemId} {
      // Allow read if user owns the item
      allow read: if isAuthenticated() && 
        (resource == null || resource.data.userId == request.auth.uid);
      
      // Allow create if user is authenticated and creating their own item
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      
      // Allow update if user owns the item
      allow update: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      // Allow delete if user owns the item
      allow delete: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
    }
    
    // Outfits collection - users can only access their own outfits
    match /outfits/{outfitId} {
      // Allow read if user owns the outfit
      allow read: if isAuthenticated() && 
        (resource == null || resource.data.userId == request.auth.uid);
      
      // Allow create if user is authenticated and creating their own outfit
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      
      // Allow update if user owns the outfit
      allow update: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      // Allow delete if user owns the outfit
      allow delete: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
    }

    // Generated outfits (Try-On results) - users can only access their own
    match /generated_outfits/{outfitId} {
      allow read: if isAuthenticated() && 
        (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Avatars collection - users can only access their own avatar
    match /avatars/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Friend requests - only sender/recipient can read; only sender can create; recipient can update (accept/reject)
    match /friend_requests/{requestId} {
      allow read: if isAuthenticated() && 
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if isAuthenticated() && 
        request.resource.data.from == request.auth.uid && 
        request.resource.data.to is string &&
        request.resource.data.status == 'pending';
      allow update: if isAuthenticated() && resource.data.to == request.auth.uid;
      allow delete: if isAuthenticated() && 
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }
    
    // Chats - only participants can read/update
    match /chats/{chatId} {
      allow read, update: if isAuthenticated() && 
        request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && 
        request.auth.uid in request.resource.data.participants;
      allow delete: if false;
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuthenticated() && 
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        // Participants can update e.g. 'seen' (markMessagesSeen)
        allow update: if isAuthenticated() && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow delete: if false;
      }
    }
    
    // Notifications - only recipient can read; only server or sender can create
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.toUserId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.toUserId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.toUserId == request.auth.uid;
    }

    // ——— Posts (Style Feed) ———
    // Managed rules: read feed (any auth user), create (author only), update (author full; others only likes/saves/comments/counts), delete (author only).
    match /style_feed_posts/{postId} {
      // Any authenticated user can read the feed (list) and individual posts (get).
      allow read: if isAuthenticated();

      // Only the author can create a post; document must have userId matching the requester.
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'createdAt']);

      // Author can update anything; other users can only update engagement fields (likes, saves, comments, counts).
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likedByUserIds', 'savedByUserIds', 'comments', 'likeCount', 'commentCount', 'viewCount', 'shareCount'])
      );

      // Only the post author can delete.
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // AI chats (dashboard chat with Cleo) - users can only access their own
    match /ai_chats/{chatId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() &&
          get(/databases/$(database)/documents/ai_chats/$(chatId)).data.userId == request.auth.uid;
      }
    }
  }
}

